{
  "name": "nextjs-boilerplate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "prebuild": "bash scripts/bump-sw.sh",
    "build": "next build",
    "start": "next start",
    "test": "NODE_ENV=test jest --reporters default",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install chromium firefox",
    "lint": "eslint src/ ",
    "lint:fix": "pnpm lint --fix",
    "lint:staged": "lint-staged --config lint-staged.config.mjs",
    "lint:commit": "commitlint --config commitlint.config.ts",
    "lint:dependencies": "knip --config knip.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "cleanup": "rm -rf out dist .next .swc coverage test-results",
    "reset": "pnpm clean --lockfile && pnpm cleanup && pnpm install",
    "favicon:build": "pnpm --filter favicon build",
    "postfavicon:build": "rm -rf ./public/site.webmanifest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "is-ci >/dev/null 2>&1 || husky"
  },
  "dependencies": {
    "@base-ui/react": "~1.8.0",
    "@configcat/sdk": "~1.1.0",
    "@hookform/resolvers": "~5.9.1",
    "@icons-pack/react-simple-icons": "~13.15.1",
    "@maskito/core": "~5.4.0",
    "@maskito/phone": "~5.4.0",
    "@maskito/react": "~5.4.0",
    "@next/third-parties": "~16.3.5",
    "@sentry/nextjs": "~10.75.0",
    "@t3-oss/env-nextjs": "~0.13.11",
    "@upstash/ratelimit": "~2.1.0",
    "@upstash/redis": "~1.38.4",
    "@vercel/analytics": "~2.0.1",
    "class-variance-authority": "~0.7.1",
    "cn": "~0.3.0",
    "libphonenumber-js": "~1.13.13",
    "lucide-react": "~1.47.0",
    "next": "~16.3.5",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-hook-form": "~7.88.0",
    "resend": "~6.28.1",
    "shadcn": "~4.21.0",
    "sonner": "~2.0.8",
    "tw-animate-css": "~1.4.0",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/compat": "2.1.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/jest": "^30.0.0",
    "@types/k6": "^2.2.1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^75.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
